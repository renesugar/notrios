    {"id": "same-line-disjoint-words", "expected": {"line": "conflict", "word": "clean", "byte": "clean"}},
    {"id": "same-token", "expected": {"line": "conflict", "word": "conflict", "byte": "conflict"}},
    {"id": "unicode-neighbours", "expected": {"line": "conflict", "word": "clean", "byte": "clean"}},
    {"id": "markdown-overlap", "expected": {"line": "conflict", "word": "conflict", "byte": "conflict"}},
    {"id": "very-long-line", "expected": {"line": "conflict", "word": "clean", "byte": "limit-rejected"}}
  ],
  "metadata_cases": [
    {"id": "title-body-overlap", "classification": "clean-field-merge"},
    {"id": "delete-edit", "classification": "durable-conflict"},
    {"id": "move-rename", "classification": "clean-field-merge"},
    {"id": "tag-add-remove", "classification": "protocol-order-lww-per-element"},
