{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notrios.example/schemas/evidence/content-checkpoint-v1.schema.json",
  "additionalProperties": false,
  "properties": {
    "canonical_profile": {"const": "notrios-canonical-json-v1"},
    "capture_window_end": {"type": "string"},
    "capture_window_start": {"type": "string"},
    "checkpoint_id": {"type": "string"},
    "contains_retroactive_artifacts": {"type": "boolean"},
    "entry_count": {"minimum": 1, "type": "integer"},
    "first_entry_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "intended_volume_ids": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
    "last_entry_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "manifest_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "manifest_size_bytes": {"minimum": 1, "type": "integer"},
    "predecessor_checkpoint_sha256": {"type": ["string", "null"]},
    "schema": {"const": "notrios.evidence.content-checkpoint.v1"},
    "seal_window_end": {"type": "string"},
    "seal_window_start": {"type": "string"},
    "source_artifact_count": {"minimum": 1, "type": "integer"},
    "verifier_version": {"type": "string"}
  },
  "required": ["schema", "checkpoint_id", "entry_count", "first_entry_sha256", "last_entry_sha256", "manifest_sha256", "manifest_size_bytes", "capture_window_start", "capture_window_end", "seal_window_start", "seal_window_end", "contains_retroactive_artifacts", "canonical_profile", "verifier_version", "intended_volume_ids", "predecessor_checkpoint_sha256", "source_artifact_count"],
  "title": "Notrios evidence content checkpoint v1",
  "type": "object"
}
