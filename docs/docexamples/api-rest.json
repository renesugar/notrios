    {
      "section": "resources-attachments",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "rest": [
          "POST /api/v1/resources",
          "POST /api/v1/documents/{document_id}/resources/{resource_id}",
          "GET /api/v1/documents/{document_id}/resources",
          "GET /api/v1/resources/{resource_id}/content",
          "GET /api/v1/resources/reports/reference",
          "GET /api/v1/admin/gc/report"
        ]
      },
      "steps": [
        {
          "comment": "# Upload raw bytes; filename via query parameter (or Content-Disposition)"
        },
        {
          "run": "curl -s -X POST 'http://127.0.0.1:8080/api/v1/resources?filename=chart.png' \\"
        },
        {
          "run": "  -H 'Content-Type: image/png' --data-binary @chart.png | jq    # -> id, uri, sha256"
        },
        {},
        {
          "comment": "# Attach to a note, list, download"
        },
        {
          "run": "curl -s -X POST http://127.0.0.1:8080/api/v1/documents/$DOC/resources/$RES \\"
        },
        {
          "run": "  -H 'Content-Type: application/json' -d '{\"relation_type\":\"embedded\"}' | jq"
        },
        {
          "run": "curl -s http://127.0.0.1:8080/api/v1/documents/$DOC/resources | jq"
        },
        {
          "run": "curl -s 'http://127.0.0.1:8080/api/v1/resources/'$RES'/content?download=1' \\"
        },
        {
          "run": "  -o downloaded-chart.png"
        },
        {},
        {
          "comment": "# Partial reads (v0.6 F3): 206 with Content-Range, or 416 naming the real size"
        },
        {
          "comment": "# when the range cannot be satisfied. Composes with ?download=1 for a resume."
        },
        {
          "run": "curl -s -H 'Range: bytes=0-1023' 'http://127.0.0.1:8080/api/v1/resources/'$RES'/content'"
        },
        {},
        {
          "comment": "# Read-only exact duplicate, unreferenced blob, notebook usage, and optional"
        },
        {
          "comment": "# perceptual review report"
        },
        {
          "run": "curl -s http://127.0.0.1:8080/api/v1/resources/reports/reference | jq"
        },
        {},
        {
          "comment": "# Retention-aware GC plan (always read-only over REST)"
        },
        {
          "run": "curl -s http://127.0.0.1:8080/api/v1/admin/gc/report | jq"
        }
      ]
    },
