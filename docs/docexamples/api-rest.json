    {
      "section": "notebooks-tags-search-notebooks-trash",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "rest": [
          "GET /api/v1/notebooks/tree",
          "POST /api/v1/notebooks",
          "POST /api/v1/documents/{document_id}/notebook",
          "GET /api/v1/tags",
          "POST /api/v1/documents/{document_id}/tags/{tag}",
          "DELETE /api/v1/documents/{document_id}/tags/{tag}",
          "GET /api/v1/search-notebooks",
          "POST /api/v1/search-notebooks",
          "GET /api/v1/trash",
          "POST /api/v1/trash/{document_id}/restore",
          "DELETE /api/v1/trash/{document_id}"
        ]
      },
      "steps": [
        {
          "run": "curl -s http://127.0.0.1:8080/api/v1/notebooks/tree | jq        # nested sidebar tree"
        },
        {
          "run": "curl -s -X POST http://127.0.0.1:8080/api/v1/notebooks \\"
        },
        {
          "run": "  -H 'Content-Type: application/json' \\"
        },
        {
          "run": "  -d '{\"name\":\"Work\",\"icon_emoji\":\"\ud83d\udcbc\"}' | jq"
        },
        {
          "run": "curl -s -X POST http://127.0.0.1:8080/api/v1/documents/$DOC/notebook \\"
        },
        {
          "run": "  -H 'Content-Type: application/json' -d \"{\\\"notebook_id\\\":\\\"$NB\\\"}\" | jq"
        },
        {
          "comment": "# POST /api/v1/documents also accepts notebook_id; omitted, the note is filed"
        },
        {
          "comment": "# in the default \"Notes\" notebook."
        },
        {},
        {
          "run": "curl -s http://127.0.0.1:8080/api/v1/tags | jq                  # with note counts"
        },
        {
          "run": "curl -s -X POST http://127.0.0.1:8080/api/v1/documents/$DOC/tags/todo | jq"
        },
        {
          "run": "curl -s -X DELETE http://127.0.0.1:8080/api/v1/documents/$DOC/tags/todo   # 204"
        },
        {},
        {
          "run": "curl -s http://127.0.0.1:8080/api/v1/search-notebooks | jq      # \"All notes\" first, \"Trash\" last"
        },
        {
          "run": "curl -s -X POST http://127.0.0.1:8080/api/v1/search-notebooks \\"
        },
        {
          "run": "  -H 'Content-Type: application/json' -d '{\"name\":\"TODO\",\"query\":\"tag:todo\",\"icon_emoji\":\"\u2705\"}' | jq"
        },
        {},
        {
          "run": "curl -s http://127.0.0.1:8080/api/v1/trash | jq"
        },
        {
          "run": "curl -s -X POST http://127.0.0.1:8080/api/v1/trash/$DOC/restore | jq"
        },
        {
          "run": "curl -s -X DELETE http://127.0.0.1:8080/api/v1/trash/$DOC \\"
        },
        {
          "run": "  -H \"X-Notrios-Confirmation: purge-document:$DOC\"            # permanent; local notes only"
        }
      ]
    },
