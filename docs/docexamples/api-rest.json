    {
      "section": "notes-create-read-edit",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "rest": [
          "POST /api/v1/documents"
        ]
      },
      "steps": [
        {
          "comment": "# Create (notebook_id optional; defaults to the \"Notes\" notebook)"
        },
        {
          "run": "curl -s -X POST http://127.0.0.1:8080/api/v1/documents \\"
        },
        {
          "run": "  -H 'Content-Type: application/json' \\"
        },
        {
          "run": "  -d '{\"title\":\"Meeting notes\",\"body\":\"# Agenda\\n\\n- apples\\n\"}' | jq"
        }
      ]
    },
    {
      "section": "notes-create-read-edit",
      "ordinal": 2,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "rest": [
          "GET /api/v1/documents/{document_id}",
          "GET /api/v1/documents/{document_id}/body"
        ]
      },
      "steps": [
        {
          "run": "curl -s http://127.0.0.1:8080/api/v1/documents/$DOC | jq"
        },
        {
          "run": "curl -s http://127.0.0.1:8080/api/v1/documents/$DOC/body     # raw Markdown"
        }
      ]
    },
    {
      "section": "optimistic-concurrency",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "rest": [
          "GET /api/v1/documents/{document_id}",
          "PUT /api/v1/documents/{document_id}",
          "DELETE /api/v1/documents/{document_id}"
        ]
      },
      "steps": [
        {
          "run": "REV=$(curl -s http://127.0.0.1:8080/api/v1/documents/$DOC | jq -r .current_revision_id)"
        },
        {},
        {
          "run": "curl -s -X PUT http://127.0.0.1:8080/api/v1/documents/$DOC \\"
        },
        {
          "run": "  -H 'Content-Type: application/json' \\"
        },
        {
          "run": "  -d \"{\\\"title\\\":\\\"Meeting notes v2\\\",\\\"body\\\":\\\"updated\\\",\\\"base_revision_id\\\":\\\"$REV\\\"}\" | jq"
        },
        {},
        {
          "comment": "# Or with If-Match (read the current revision after any preceding write):"
        },
        {
          "run": "REV=$(curl -s http://127.0.0.1:8080/api/v1/documents/$DOC | jq -r .current_revision_id)"
        },
        {
          "run": "curl -s -X DELETE http://127.0.0.1:8080/api/v1/documents/$DOC \\"
        },
        {
          "run": "  -H \"If-Match: \\\"$REV\\\"\"            # 204: moved to Trash"
        }
      ]
    },
    {
      "section": "surgical-edits-and-note-operations",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "rest": [
          "PATCH /api/v1/documents/{document_id}",
          "POST /api/v1/documents/{document_id}/append"
        ]
      },
      "steps": [
        {
          "comment": "# String-replace edit; ambiguous matches fail unless replace_all; dry_run previews"
        },
        {
          "run": "curl -s -X PATCH http://127.0.0.1:8080/api/v1/documents/$DOC \\"
        },
        {
          "run": "  -H 'Content-Type: application/json' \\"
        },
        {
          "run": "  -d \"{\\\"base_revision_id\\\":\\\"$REV\\\",\\\"edits\\\":[{\\\"search\\\":\\\"apples\\\",\\\"replace\\\":\\\"oranges\\\"}],\\\"dry_run\\\":true}\" | jq"
        },
        {},
        {
          "run": "curl -s -X POST http://127.0.0.1:8080/api/v1/documents/$DOC/append \\"
        },
        {
          "run": "  -H 'Content-Type: application/json' -d '{\"text\":\"- follow-up item\"}' | jq"
        },
        {
          "comment": "# also: /prepend, GET /lines?start=1&end=20, GET /search-in?pattern=agenda, GET /outline"
        }
      ]
    },
