    {
      "section": "exporting-a-notrios-archive",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "cli": [
          "export archive"
        ]
      },
      "steps": [
        {
          "run": "go run ./cmd/notriosctl export archive ./my-archive                      # everything"
        },
        {
          "run": "go run ./cmd/notriosctl export archive --query 'tag:todo' ./todo-archive # query-scoped"
        }
      ]
    },
    {
      "section": "exporting-a-native-archive-v2-snapshot",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "cli": [
          "export archive-v2"
        ]
      },
      "steps": [
        {
          "comment": "# Complete database backup."
        },
        {
          "run": "go run ./cmd/notriosctl export archive-v2 ./notrios-backup"
        },
        {},
        {
          "comment": "# Explicitly scoped subset transfer."
        },
        {
          "run": "go run ./cmd/notriosctl export archive-v2 --target subset_transfer \\"
        },
        {
          "run": "  --notebooks nb_research --tags shared ./research-transfer"
        }
      ]
    },
    {
      "section": "verifying-and-restoring-an-archive-v2-snapshot",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "cli": [
          "verify archive-v2",
          "restore archive-v2"
        ]
      },
      "steps": [
        {
          "comment": "# Read-only integrity/contents check."
        },
        {
          "run": "go run ./cmd/notriosctl verify archive-v2 ./notrios-backup"
        },
        {},
        {
          "comment": "# Restore into a fresh database. The intent is mandatory."
        },
        {
          "run": "go run ./cmd/notriosctl restore archive-v2 --intent adopt \\"
        },
        {
          "run": "  --db ./restored/notes.sqlite ./notrios-backup"
        }
      ]
    },
    {
      "section": "fast-same-schema-whole-library-snapshots",
      "ordinal": 1,
      "kind": "recipe",
      "language": "bash",
      "uses": {
        "cli": [
          "snapshot create",
          "snapshot verify",
          "snapshot restore"
        ]
      },
      "steps": [
        {
          "run": "go run ./cmd/notriosctl snapshot create --db data/notes.sqlite \\"
        },
        {
          "run": "  --asset-store data/assets ./notrios-physical-snapshot"
        },
        {
          "run": "go run ./cmd/notriosctl snapshot verify ./notrios-physical-snapshot"
        },
        {
          "run": "go run ./cmd/notriosctl snapshot restore --intent replace \\"
        },
        {
          "run": "  --db data/notes.sqlite --asset-store data/assets \\"
        },
        {
          "run": "  ./notrios-physical-snapshot"
        }
      ]
    },
    {
      "section": "importing-a-notrios-archive",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "cli": [
          "import archive"
        ]
      },
      "steps": [
        {
          "comment": "# 1. Analyze; writes my-archive/import-config.json (or --write-config <path>)"
        },
        {
          "run": "go run ./cmd/notriosctl import archive --dry-run ./my-archive"
        },
        {},
        {
          "comment": "# 2. Review/edit the renames in import-config.json, then import"
        },
        {
          "run": "go run ./cmd/notriosctl import archive --import-config ./my-archive/import-config.json ./my-archive"
        }
      ]
    }
  ]
}
