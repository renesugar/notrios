{
  "schema": "notrios.docexamples.v1",
  "document": "docs/import-export.md",
  "note": "The published examples on this page are generated from here by `go run ./cmd/docexamples --write`. Each recipe's steps are the published text; what this file adds is the declaration beside them -- the CLI commands and REST routes it drives, checked against the CLI spec and the routes the server registers, so a documented command that stops existing fails the build.",
  "examples": [
    {
      "section": "import-and-export",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "cli": [
          "import joplin-raw"
        ]
      },
      "steps": [
        {
          "run": "go run ./cmd/notriosctl import joplin-raw --dry-run \"/path/to/export dir\""
        },
        {
          "run": "./bin/notriosctl   import joplin-raw --dry-run \"/path/to/export dir\""
        }
      ]
    },
    {
      "section": "2-dry-run",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "cli": [
          "import joplin-raw"
        ]
      },
      "steps": [
        {
          "run": "go run ./cmd/notriosctl import joplin-raw --dry-run \"/path/to/joplin-export\""
        }
      ]
    },
    {
      "section": "3-import",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "cli": [
          "import joplin-raw"
        ]
      },
      "steps": [
        {
          "run": "go run ./cmd/notriosctl import joplin-raw \\"
        },
        {
          "run": "  --db ./data/notes.sqlite \\"
        },
        {
          "run": "  --asset-store ./data/assets \\"
        },
        {
          "run": "  --batch-size 100 \\"
        },
        {
          "run": "  --import-config \"/path/to/joplin-export/import-config.json\" \\"
        },
        {
          "run": "  \"/path/to/joplin-export\""
        }
      ]
    },
    {
      "section": "obsidian-vault-directory",
      "ordinal": 1,
      "kind": "recipe",
      "language": "sh",
      "uses": {
        "cli": [
          "import obsidian"
        ]
      },
      "steps": [
        {
          "run": "go run ./cmd/notriosctl import obsidian --dry-run \\"
        },
        {
          "run": "  --write-config \"/path/to/vault/.notrios/import-config.json\" \"/path/to/vault\""
        },
        {
          "run": "go run ./cmd/notriosctl import obsidian --preserve-source \\"
        },
        {
          "run": "  --import-config \"/path/to/vault/.notrios/import-config.json\" \"/path/to/vault\""
        }
      ]
    },
    {
