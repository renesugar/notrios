{
    "$schema": "http://json-schema.org/schema#",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "uuid": {
                "type": "string"
            },
            "name": {
                "type": "string"
            },
            "created_at": {
                "type": "string"
            },
            "chat_messages": {
                "type": "array",
                "items": {
                    "type": "object",
                    "properties": {
                        "uuid": {
                            "type": "string"
                        },
                        "sender": {
                            "type": "string"
                        },
                        "created_at": {
                            "type": "string"
                        },
                        "text": {
                            "type": "string"
                        },
                        "content": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "type": {
                                        "type": "string"
                                    },
                                    "text": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "text",
                                    "type"
                                ]
                            }
                        }
                    },
                    "required": [
                        "created_at",
                        "sender",
                        "text",
                        "uuid"
                    ]
                }
            }
        },
        "required": [
            "chat_messages",
            "created_at",
            "name",
            "uuid"
        ]
    }
}
